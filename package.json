{
  "name": "react-ambient-light-adaptive-theme",
  "version": "1.0.0",
  "description": "A React provider that switches between light and dark themes based on the ambient light around the user, with system-preference and time-of-day fallbacks.",
  "keywords": [
    "react",
    "nextjs",
    "theme",
    "dark-mode",
    "light-mode",
    "adaptive",
    "ambient-light",
    "ambientlightsensor",
    "generic-sensor-api",
    "theming"
  ],
  "homepage": "https://chandana-galgali.github.io/react-ambient-light-adaptive-theme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandana-galgali/react-ambient-light-adaptive-theme.git"
  },
  "bugs": {
    "url": "https://github.com/chandana-galgali/react-ambient-light-adaptive-theme/issues"
  },
  "author": "Chandana Galgali <chandana.galgali@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./script": {
      "import": {
        "types": "./dist/script.d.ts",
        "default": "./dist/script.js"
      },
      "require": {
        "types": "./dist/script.d.cts",
        "default": "./dist/script.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "tsx --tsconfig tsconfig.test.json --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "next": "15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
